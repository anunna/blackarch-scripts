#!/bin/bash

# This script will sync a custom Arch Linux repository with pacman,
# install each tool alphabetically, launch it, and report any errors

# Change this variable to the location of your custom repository
repo_location="/path/to/custom/repo"

# Change this variable to the name of your custom repository
repo_name="customrepo"

# Change this variable to the location of your pacman.conf file
pacman_conf="/etc/pacman.conf"

# Add the custom repository to pacman.conf
echo "[$repo_name]
SigLevel = Optional TrustAll
Server = file://$repo_location" >> $pacman_conf

# Refresh the package database
pacman -Sy

# Initialize variables for reporting errors
install_errors=0
launch_errors=0
total_tools=0

# Iterate over each package in the custom repository alphabetically
for package in $(pacman -Sl $repo_name | awk '{print $1}' | sort); do
    echo "Checking $package"
    total_tools=$((total_tools+1))

    # Install the package
    pacman -S --noconfirm $package
    if [ $? -ne 0 ]; then
        echo "$package failed to install"
        install_errors=$((install_errors+1))
        continue
    fi

    # Launch the package
    $package
    if [ $? -ne 0 ]; then
        echo "$package failed to launch"
        launch_errors=$((launch_errors+1))
    else
        echo "$package passed"
    fi
done

# Remove the custom repository from pacman.conf
sed -i "/\[$repo_name\]/,+1d" $pacman_conf

# Print summary of results
echo "Total tools checked: $total_tools"
echo "Total install errors: $install_errors"
echo "Total launch errors: $launch_errors"
